<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.PinMemory" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryVariant">@color/purple_dark</item>
        <item name="colorSecondary">@color/pink_accent</item>

        <item name="materialButtonStyle">@style/Widget.PinMemory.Button</item>
    </style>

    <style name="Theme.PinMemory" parent="Base.Theme.PinMemory" />

    <style name="Widget.PinMemory.Button" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/purple_primary</item>
        <item name="cornerRadius">50dp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <style name="Theme.PinMemory.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/purple_primary</item>
        <item name="hintTextColor">@color/text_hint</item>
    </style>
</resources>